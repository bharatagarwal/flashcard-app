{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recur deck version 2",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "concepts",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "text",
            "equation",
            "diagram"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "assetID": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "boolean"
        },
        "caption": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "equation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diagram"
              }
            }
          },
          "then": {
            "required": [
              "assetID"
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "role",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "intuition",
            "derivation",
            "example",
            "pitfall",
            "history",
            "explanation"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "sourceURLs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "history"
              }
            }
          },
          "then": {
            "required": [
              "sourceURLs"
            ],
            "properties": {
              "sourceURLs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "explanation",
        "pitfall",
        "sources",
        "revision",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "pitfall": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "prerequisiteIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "diagram": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceImage": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "conceptID",
        "revision",
        "kind",
        "prompt",
        "answer",
        "hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conceptID": {
          "type": "string",
          "minLength": 1
        },
        "objectiveID": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "change": {
          "enum": [
            "wording",
            "explanation",
            "correction"
          ]
        },
        "answerBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "explanationSections": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "archived": {
          "type": "boolean",
          "description": "Archived cards keep their schedules and history but do not enter review queues."
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "mediaType",
        "data",
        "altText"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mediaType": {
          "const": "application/pdf"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        },
        "darkData": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  }
}
